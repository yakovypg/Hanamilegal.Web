{
  "RefreshTokenCleanup": {
    "Interval": "01:00:00",
    "RevokedTokenRetention": "24:00:00"
  },
  "Swagger": {
    "ApiVersion": "1.0",
    "SchemeName": "Bearer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
