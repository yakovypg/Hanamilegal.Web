@using Hanamilegal.Web.Auth.Models

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
        <div class="container big-text">
            <p class="navbar-brand">Internals</p>
            
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">
                            Home
                        </a>
                    </li>
                    
                    @if (User.IsInRole(UserRole.ApplicationViewer.ToString()) ||
                         User.IsInRole(UserRole.Admin.ToString()))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Applications/Index">
                                Applications
                            </a>
                        </li>
                    }
                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Account/Logout" class="d-flex ms-auto">
                        <button type="submit"
                                class="btn btn-link nav-link text-dark p-0"
                                title="Logout"
                                aria-label="Logout">
                            <i class="bi bi-box-arrow-right subtitle-text"></i>
                            <span class="d-sm-none ms-1">Logout</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </nav>
</header>